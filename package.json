{
  "name": "hogen-akinator",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "licenses": "node scripts/build-licenses.ts",
    "licenses:check": "node scripts/build-licenses.ts --check",
    "geo:fetch": "node scripts/geo/fetch.ts",
    "geo:build": "node scripts/geo/build.ts",
    "predev": "npm run licenses",
    "dev": "vite",
    "prebuild": "npm run licenses",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run licenses",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "mapshaper": "^0.8.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  }
}
